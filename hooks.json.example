{
  "agy-companion": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "python \"C:/Users/Abiyy/Self-Project/agy-companion/hook_reporter.py\" --event SessionStart",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python \"C:/Users/Abiyy/Self-Project/agy-companion/hook_reporter.py\" --event PreInvocation",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/Abiyy/Self-Project/agy-companion/hook_reporter.py\" --event PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/Abiyy/Self-Project/agy-companion/hook_reporter.py\" --event PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python \"C:/Users/Abiyy/Self-Project/agy-companion/hook_reporter.py\" --event Stop",
        "timeout": 5
      }
    ]
  }
}
